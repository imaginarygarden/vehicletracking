@page "/login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization

@attribute [AllowAnonymous]

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5" GutterBottom="true">
            Sign into your account
        </MudText>

        <EditForm Model="_model" OnValidSubmit="HandleSignIn">
            <DataAnnotationsValidator />

            <MudStack Spacing="3">

                <MudTextField T="string"
                              Label="Username"
                              @bind-Value="_model.Username"
                              For="@(() => _model.Username)"
                              Variant="Variant.Outlined"
                              Disabled="_loading" />

                <MudTextField T="string"
                              Label="Password"
                              @bind-Value="_model.Password"
                              For="@(() => _model.Password)"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Disabled="_loading" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error">
                        @_error
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="_loading">

                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true"
                                             Class="me-2" />
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }

                </MudButton>

            </MudStack>

        </EditForm>

    </MudPaper>

</MudContainer>

@code {
    private LoginModel _model = new();

    private bool _loading;
    private string? _error;
    private string? _returnUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

            if (QueryHelpers.ParseQuery(uri.Query)
                .TryGetValue("ReturnUrl", out var returnUrl))
            {
                _returnUrl = returnUrl;
            }
        }
    }

    private async Task HandleSignIn()
    {
        _loading = true;
        _error = null;

        try
        {
            var response = await JSRuntime.InvokeAsync<bool>(
                "window.login",
                _model.Username,
                _model.Password
            );

            if (response)
            {
                NavigationManager.NavigateTo(
                    string.IsNullOrWhiteSpace(_returnUrl) ? "/" : _returnUrl,
                    forceLoad: true
                );
            }
            else
            {
                _error = "Invalid username or password.";
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            _error = "Unable to connect to the server.";
        }
        finally
        {
            _loading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";
    }
}