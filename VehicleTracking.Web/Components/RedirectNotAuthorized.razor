@using Microsoft.AspNetCore.Components.Authorization
@using VehicleTracking.Application.Common

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@code {
    protected override async Task OnInitializedAsync()
    {
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var redirectPath = user.Identity?.IsAuthenticated == true 
            ? EnvironmentUtilities.GetVariable<string>("ACCESS_DENIED_PATH") 
            : EnvironmentUtilities.GetVariable<string>("LOGIN_PATH");
        
        NavigationManager.NavigateTo(
            $"{redirectPath}?ReturnUrl={Uri.EscapeDataString(returnUrl)}"
        );
    }
}
